+    //strict mode only. Compilers lay functions out back to back, so the code after the end of a known function
+    //(skipping alignment nops) is the next function even when nothing calls it directly (callbacks, vtables, leaf
+    //functions reached through data pointers). Each candidate must decode cleanly and reach a real terminator, so
+    //this stops at data instead of walking through it.
+    public static List<MipsFunction> DiscoverAdjacent(MipsInstruction[] all, List<MipsFunction> existing,
+        string overlayName)
+    {
+        var result = new List<MipsFunction>();
+        if (all.Length == 0 || !DetectorOptions.Strict) return result;
+
+        var codeEnd = all[^1].Vram + 4;
+        var covered = new bool[all.Length];
+        var startsAt = new HashSet<uint>();
+        foreach (var f in existing)
+        {
+            startsAt.Add(f.Start);
+            var a = InstrIndex(all, f.Start);
+            var b = Math.Min(InstrIndex(all, f.End), all.Length);
+            for (var k = Math.Max(a, 0); k < b; k++) covered[k] = true;
+        }
+
+        var queue = new Queue<int>();
+        foreach (var f in existing)
+        {
+            var e = InstrIndex(all, f.End);
+            if (e >= 0 && e < all.Length) queue.Enqueue(e);
+        }
+
+        while (queue.Count > 0)
+        {
+            var i = queue.Dequeue();
+            while (i < all.Length && !covered[i] && all[i].IsNop) i++;
+            if (i >= all.Length || covered[i]) continue;
+            if (!IsKnownInstruction(all[i]) || !IsPlausibleInStrict(all[i])) continue;
+
+            var bound = i + 1;
+            while (bound < all.Length && !covered[bound]) bound++;
+
+            var ei = Math.Clamp(RefineEnd(all, i, bound, 0, out var kind), i + 1, all.Length);
+            if (kind != EndKind.Terminated || IsJunkBody(all, i, ei) || SliceHasUnknownInstruction(all, i, ei)) continue;
+
+            var addr = all[i].Vram;
+            var name = $"func_{addr:X8}";
+            result.Add(new MipsFunction
+            {
+                Name = name,
+                OverlayName = overlayName,
+                EmittedName = name,
+                Start = addr,
+                End = all[ei - 1].Vram + 4,
+                Instructions = all[i..ei]
+            });
+            for (var k = i; k < ei; k++) covered[k] = true;
+            queue.Enqueue(ei);
+        }
+
+        return result;
+    }
