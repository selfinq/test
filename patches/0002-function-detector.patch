new file mode 100644
index 0000000..82f9865
--- /dev/null
+++ b/RecompOne.Recompiler/Analysis/DetectorOptions.cs
@@ -0,0 +1,34 @@
+namespace RecompOne.Recompiler.Analysis;
+
+//Switches for the function detector. Defaults keep the original (disc game) behaviour.
+//Strict mode is meant for raw images (arcade) where data is interleaved with code and there is no symbol info:
+//  * a function also ends at an unconditional j / b (after its delay slot) once no earlier branch reaches past it
+//  * a function never contains a word that does not decode to a known instruction (it is cut in front of it)
+//  * a run of MaxNopRun nops (zero-filled memory) ends a function, nop-only bodies are rejected
+//  * forward j/b targets farther than MaxIntraJump bytes are treated as tail calls and do not extend the function
+//  * functions found only by scanning (jal targets / prologue pointers) must reach a real end, otherwise they are rejected
+//Enable with env RECOMPONE_STRICT_DETECT=1 (config wiring is up to Program.cs/ConfigLoader.cs, not touched here).
+public static class DetectorOptions
+{
+    public static bool Strict { get; set; } = IsOn("RECOMPONE_STRICT_DETECT");
+
+    //this many consecutive nops (zero words) end a function; a body made only of nops is rejected
+    public static int MaxNopRun { get; set; } = (int)ReadHex("RECOMPONE_MAX_NOP_RUN", 16);
+
+    public static uint MaxIntraJump { get; set; } = ReadHex("RECOMPONE_MAX_INTRA_JUMP", 0x2000);
+
+    private static bool IsOn(string name)
+    {
+        var v = Environment.GetEnvironmentVariable(name);
+        return v is "1" or "true" or "TRUE" or "True" or "on";
+    }
+
+    private static uint ReadHex(string name, uint def)
+    {
+        var v = Environment.GetEnvironmentVariable(name);
+        if (string.IsNullOrWhiteSpace(v)) return def;
+        v = v.Trim();
+        if (v.StartsWith("0x", StringComparison.OrdinalIgnoreCase)) v = v[2..];
+        return uint.TryParse(v, System.Globalization.NumberStyles.HexNumber, null, out var r) ? r : def;
+    }
+}
