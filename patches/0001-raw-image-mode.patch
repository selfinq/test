+    //Arcade/raw entry: explicit image + addresses. No disc, no SYSTEM.CNF, no PS1 SDK HLE patches.
+    public static void WriteRaw(RecompOneConfig config, PsxExe exe, string outDir)
+    {
+        var className = SafeIdentifier(config.Game.Name);
+        var overlayResults = new List<OverlayResult> { AnalyzeMain(config, exe) };
+        var images = overlayResults.Select(r => new ImageFunctions(r.Name, r.Functions, r.Instructions)).ToList();
+        FunctionPipeline.ScanCrossImage(images);
+        FunctionPipeline.ScanEscapesToFixpoint(images);
+        var allFuncs = overlayResults.SelectMany(o => o.Functions).ToList();
+        ResolveCollisions(allFuncs);
+        ApplyPatches(allFuncs, config.Patches);
+        Console.WriteLine("[Recompiler] raw/arcade mode: PS1 SDK HLE patches (SdkPatches) NOT applied");
+        WriteAll(config, outDir, className, exe, new SystemCfg(), overlayResults, allFuncs, false);
+    }
