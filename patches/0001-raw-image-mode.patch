+if (config.Image != null)
+{
+    var imgPath = ResolvePath(config.Image)!;
+    if (!File.Exists(imgPath)) { Console.Error.WriteLine($"image not found: {imgPath}"); return 1; }
+    if (config.ImageBase == null || config.Entry == null)
+    { Console.Error.WriteLine("raw mode needs imageBase and entry (hex strings)"); return 1; }
+    var code = File.ReadAllBytes(imgPath);
+    var exe = new RecompOne.Recompiler.Psx.PsxExe
+    {
+        Destination = Convert.ToUInt32(config.ImageBase, 16),
+        InitialPC = Convert.ToUInt32(config.Entry, 16),
