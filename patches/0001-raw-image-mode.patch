+    };
+    var rawOut = Path.GetFullPath(Path.Combine(configDir, config.Game.Output));
+    Directory.CreateDirectory(rawOut);
+    Console.WriteLine($"[RecompOne] RAW image {imgPath} ({code.Length:X} bytes) base=0x{exe.Destination:X8} entry=0x{exe.InitialPC:X8}");
+    try { OverlayWriter.WriteRaw(config, exe, rawOut); Console.WriteLine("[RecompOne] Recompilation finished."); return 0; }
+    catch (Exception ex) { Console.Error.WriteLine($"[RecompOne] Error: {ex.Message}"); Console.Error.WriteLine(ex.StackTrace); return 1; }
